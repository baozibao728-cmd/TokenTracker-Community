{
  "name": "tokentracker-community-database-validation",
  "private": true,
  "type": "module",
  "scripts": {
    "build:migration": "node build-migration.mjs",
    "check:migration": "node build-migration.mjs --check",
    "build:source-breakdown": "node build-source-breakdown-migration.mjs",
    "check:source-breakdown": "node build-source-breakdown-migration.mjs --check",
    "test:config": "node --test config.test.mjs",
    "test:pg15": "node validate.mjs",
    "test:source-breakdown": "node validate-source-breakdown.mjs",
    "build:edges": "node build-edges.mjs",
    "check:edges": "node build-edges.mjs --check && node check-edge-types.mjs",
    "test:edges": "node validate-edges.mjs",
    "verify": "npm run check:migration && npm run check:source-breakdown && npm run test:config && npm run check:edges && npm run test:pg15 && npm run test:source-breakdown && npm run test:edges && node ../deploy/scan-artifacts.mjs"
  }
}
